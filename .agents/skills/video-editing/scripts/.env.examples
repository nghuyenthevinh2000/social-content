# Copy to .env at the repository root (or .agents/skills/video-editing/.env)
# and fill in your credentials. Never commit .env files.

# Required for ElevenLabs eleven_v3 TTS (synthesize_eleven_v3.py)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Required for Vertex AI / Gemini video generation & reel analysis (engine.py)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# Optional: path to GCP service account JSON if not using `gcloud auth application-default login`
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
