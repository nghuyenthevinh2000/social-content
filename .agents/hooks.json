{
  "skill-selection-router": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "uv run --project .. hooks/skill-selector/skill_injector_hook.py",
        "timeout": 15
      }
    ]
  },
  "story-engine-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project .. skills/story-engine/hooks/story_engine_guard_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
