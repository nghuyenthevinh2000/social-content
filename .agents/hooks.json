{
  "skill-selection-router": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "uv run --project . scripts/skill_injector_hook.py",
        "timeout": 15
      }
    ]
  },
  "folder-relevance-router": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "uv run --project . scripts/folder_injector_hook.py",
        "timeout": 15
      }
    ]
  },
  "frontmatter-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "uv run --project . scripts/frontmatter_guard_hook.py",
        "timeout": 15
      }
    ]
  }
}
