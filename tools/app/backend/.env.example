# Backend config for tools/app (copy to .env and export before starting server.py).

# Database configuration (PostgreSQL)
# Local dev default points to localhost:5432. In Docker, backend connects to postgres:5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aibrand
POSTGRES_PASSWORD=
DB_POOL_MAX=10

# Object storage (S3-compatible: RustFS in local dev, Cloudflare R2, or Google Cloud Storage)
BLOB_ENDPOINT=http://localhost:9000
BLOB_PUBLIC_ENDPOINT=http://localhost:9000
BLOB_BUCKET=aibrand
BLOB_ACCESS_KEY=
BLOB_SECRET_KEY=
BLOB_REGION=us-east-1

# Retention & Server settings
RETENTION_DAYS=30
API_THREADS=64

# Glasser API key for competitor Reels harvesting (required for Docker/remote; optional if `glasser login` was run locally).
GLASSER_API_KEY=

# ACP harness that writes the 3 topics: agy | opencode | claude | codex
# Unset = first installed, in that order.
VIRAL_APP_AGENT=agy

# Model for the agy harness (Antigravity CLI ACP mode). Unset = use agy's default CLI model.
VIRAL_APP_AGY_MODEL=gemini-3.8-flash-low

# Model for the opencode harness (opencode's own env). Free models work without opencode auth.
# Written for `docker run --env-file`; if you `source` this file in a shell, wrap the JSON in single quotes.
OPENCODE_CONFIG_CONTENT={"model":"opencode/deepseek-v4.1-flash-free"}

# Scheduling (backend/handler.py): job processes per worker, and running jobs per client (X-Client-Id).
VIRAL_APP_MAX_PROCESSES=2
VIRAL_APP_MAX_PER_CLIENT=1

# Max videos harvested per topic/sheet (0 = no cap, default 5).
# VIRAL_APP_MAX_VIDEOS=5

# Glasser local cache TTL in hours (0 = never expire; default 24).
# VIRAL_APP_CACHE_TTL_HOURS=24

# Gemini Agent Platform (Enterprise) / Omni Video generation
GOOGLE_GENAI_USE_ENTERPRISE=true
AGENT_PLATFORM_MODEL=gemini-omni-1.2-flash
AGENT_PLATFORM_PROJECT=gen-lang-client-0582170752
AGENT_PLATFORM_LOCATION=global
VIDEO_GENERATION_DURATION=15
RATE_PER_SEC_MICRO=23000
