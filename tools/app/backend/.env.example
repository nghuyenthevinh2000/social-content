# Backend config for tools/app (copy to .env and export before starting server.py).

# ACP harness that writes the 3 topics: agy | opencode | claude | codex
# Unset = first installed, in that order.
VIRAL_APP_AGENT=agy

# Model for the opencode harness (opencode's own env). Free models work without opencode auth.
# Written for `docker run --env-file`; if you `source` this file in a shell, wrap the JSON in single quotes.
OPENCODE_CONFIG_CONTENT={"model":"opencode/deepseek-v4.1-flash-free"}

# Scheduling (backend/handler.py): job processes per worker, and running jobs per client (X-Client-Id).
VIRAL_APP_MAX_PROCESSES=2
VIRAL_APP_MAX_PER_CLIENT=1

# Where job runs and jobs.db (SQLite job store) live.
# Unset = local/app-runs (dev) or the OS app-data folder (desktop build). Docker: /data/runs (the volume).
# Leave commented rather than empty: an empty value overrides the image default.
# VIRAL_APP_RUNS=/data/runs
